<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Glosa.App"
        xmlns:vm="using:Glosa.App.ViewModels"
        xmlns:c="using:Glosa.App.Controls"
        x:Class="Glosa.App.Views.PluginPickerWindow"
        x:DataType="vm:PluginPickerViewModel"
        Width="460" Height="480" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <c:InfoTip DockPanel.Dock="Right" Text="{Binding Tip}" Margin="6,0,0,0" />
            <TextBox Name="Filter" Text="{Binding Filter}" KeyDown="OnFilterKeyDown"
                     PlaceholderText="{x:Static l:Strings.AudioPluginsFilter}"
                     AutomationProperties.Name="{x:Static l:Strings.AudioPluginsFilter}" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Content="{x:Static l:Strings.AudioPluginsAdd}" Command="{Binding PickCommand}" IsDefault="True"
                        MinWidth="72" />
                <Button Content="{x:Static l:Strings.PromptCancel}" Click="OnCancel" IsCancel="True" MinWidth="72" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="{x:Static l:Strings.AudioPluginsAddFile}" Click="OnAddFile" />
                <Button Content="{x:Static l:Strings.AudioPluginsRescan}" Command="{Binding Owner.RescanCommand}" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Owner.ScanStatus}" Opacity="0.75" TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   IsVisible="{Binding Owner.ScanStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <!-- A double click adds. -->
        <ListBox ItemsSource="{Binding Shown}" SelectedItem="{Binding Selected}"
                 AutomationProperties.Name="{Binding Title}" DoubleTapped="OnDoubleTapped">
            <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="vm:FoundRow">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FoundRow">
                    <StackPanel ToolTip.Tip="{Binding Plugin.Path}">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
