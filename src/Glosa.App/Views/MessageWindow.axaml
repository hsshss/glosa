<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Glosa.App.Views.MessageWindow"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="12" Spacing="10">
        <TextBlock Name="Body" TextWrapping="Wrap" />
        <Button Content="OK" Click="OnClose" IsDefault="True" IsCancel="True"
                MinWidth="72" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
