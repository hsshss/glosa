<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Program.cs: on macOS the main thread runs the run loop, which Brack works on. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <!-- Cancelling a test sooner is not worth threading xUnit's token through every wait. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- A dispatcher for the view models, with no window on screen. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Glosa.Core\Glosa.Core.csproj" />
    <ProjectReference Include="..\..\src\Glosa.App\Glosa.App.csproj" />
    <!-- For their encoders, which are plain arithmetic. -->
    <ProjectReference Include="..\..\src\Glosa.Midi.MacOS\Glosa.Midi.MacOS.csproj" />
    <ProjectReference Include="..\..\src\Glosa.Midi.Linux\Glosa.Midi.Linux.csproj" />
  </ItemGroup>

  <!-- Brack's test instrument, built beside it, for the audio plugin tests (Directory.Build.props). -->
  <ItemGroup Condition="'$(BrackSource)' == 'Project'">
    <AssemblyMetadata Include="BrackTestSynth"
                      Value="$([System.IO.Path]::GetFullPath('$([System.IO.Path]::GetDirectoryName($(BrackProject)))/../../../build/bin/brack-test-synth.clap'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- The definition the player ships with, so the tests hold it to what they say. -->
    <None Include="..\..\src\Glosa.App\define.yaml" Link="define.yaml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>